{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qfoldit.github.io/qsis/0.1/schemas/scientific-job-request.schema.json",
  "title": "QSIS Scientific Job Request",
  "description": "Mission-bound request for a provider-neutral scientific capability. The capability manifest defines the schema for parameters.",
  "type": "object", "additionalProperties": false,
  "required": ["contract", "job_id", "mission", "subject", "capability", "inputs", "parameters", "execution", "authorization"],
  "properties": {
    "contract": { "const": "qfoldit.qsis.scientific-job-request/0.1" },
    "job_id": { "type": "string", "format": "uuid" },
    "mission": {
      "type": "object", "additionalProperties": false,
      "required": ["mission_id", "mission_version", "mission_inception_sha256", "mission_contract_sha256"],
      "properties": {
        "mission_id": { "type": "string", "minLength": 1 },
        "mission_version": { "type": "string", "minLength": 1 },
        "mission_inception_sha256": { "$ref": "#/$defs/sha256" },
        "mission_contract_sha256": { "$ref": "#/$defs/sha256" },
        "submission_id": { "type": ["string", "null"], "format": "uuid" },
        "action_envelope_sha256": { "$ref": "#/$defs/sha256OrNull" }
      }
    },
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["scientific_object_id", "schema_id", "schema_version"],
      "properties": {
        "scientific_object_id": { "type": "string", "minLength": 1 },
        "schema_id": { "type": "string", "minLength": 1 },
        "schema_version": { "type": "string", "minLength": 1 }
      }
    },
    "capability": {
      "type": "object", "additionalProperties": false,
      "required": ["capability_id", "manifest_sha256"],
      "properties": {
        "capability_id": { "type": "string", "minLength": 1 },
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "provider_constraint": { "type": ["string", "null"] }
      }
    },
    "inputs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["artifact_id", "media_type", "format", "sha256"],
        "properties": {
          "artifact_id": { "type": "string", "minLength": 1 },
          "uri": { "type": ["string", "null"], "format": "uri" },
          "media_type": { "type": "string", "minLength": 1 },
          "format": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "size_bytes": { "type": ["integer", "null"], "minimum": 0 },
          "license_ref": { "type": ["string", "null"] },
          "rights_ref": { "type": ["string", "null"] }
        }
      }
    },
    "parameters": { "type": "object", "description": "Must validate against the input schema URI in the selected capability manifest." },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "idempotency_key", "resource_budget"],
      "properties": {
        "mode": { "enum": ["sync", "async", "stream"] },
        "idempotency_key": { "type": "string", "minLength": 16, "maxLength": 256 },
        "deadline": { "type": ["string", "null"], "format": "date-time" },
        "resource_budget": {
          "type": "object", "additionalProperties": false,
          "required": ["max_runtime_seconds"],
          "properties": {
            "max_runtime_seconds": { "type": "integer", "minimum": 1 },
            "max_cpu_cores": { "type": ["number", "null"], "exclusiveMinimum": 0 },
            "max_memory_gb": { "type": ["number", "null"], "exclusiveMinimum": 0 },
            "max_gpu_memory_gb": { "type": ["number", "null"], "exclusiveMinimum": 0 },
            "max_cost": { "type": ["number", "null"], "minimum": 0 },
            "currency": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" }
          }
        },
        "random_seed": { "type": ["integer", "null"] }
      }
    },
    "authorization": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "required_scopes"],
      "properties": {
        "status": { "enum": ["pending", "approved", "rejected", "blocked"] },
        "approval_ref": { "type": ["string", "null"] },
        "approved_by": { "type": ["string", "null"] },
        "approved_at": { "type": ["string", "null"], "format": "date-time" },
        "required_scopes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "data_residency_policy": { "type": ["string", "null"] }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "sha256OrNull": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
  }
}